# Проверенный профиль Gemini для запуска с ключом Google AI Studio.
# https://aistudio.google.com/apikey
REQVALIDATOR_PROVIDER=compatible
REQVALIDATOR_MODEL=gemini-2.5-flash
REQVALIDATOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
REQVALIDATOR_API_KEY=
REQVALIDATOR_COMPATIBLE_FORMAT=json_schema

# Для OpenAI Responses переключите провайдер на openai, задайте модель OpenAI,
# очистите REQVALIDATOR_BASE_URL и REQVALIDATOR_API_KEY и заполните OPENAI_API_KEY.
# Заполняйте только параметры, поддерживаемые выбранной моделью.
OPENAI_API_KEY=
REQVALIDATOR_REASONING_EFFORT=
REQVALIDATOR_TEMPERATURE=
REQVALIDATOR_SEED=
REQVALIDATOR_MAX_OUTPUT_TOKENS=

REQVALIDATOR_TIMEOUT=120
REQVALIDATOR_VALIDATION_RETRIES=1
REQVALIDATOR_MAX_INPUT_CHARS=100000
REQVALIDATOR_LOCAL_BATCH_SIZE=6
# Минимальный интервал между запросами в секундах.
REQVALIDATOR_MIN_REQUEST_INTERVAL=5
# Один запрос за раз для профиля Gemini. Интервал между запросами общий.
REQVALIDATOR_CONCURRENCY=1
# Прогресс построчно в stderr. QUIET отключает строки прогресса.
REQVALIDATOR_PROGRESS=false
REQVALIDATOR_QUIET=false
# Сводка замеров в stderr и поле timings при --json-output.
REQVALIDATOR_TIMINGS=false
# Необязательный reasoning_effort только для проходов слияния.
REQVALIDATOR_MERGE_REASONING_EFFORT=
# Дополнительные роли через запятую, например qa,api. Пусто — роли выключены.
REQVALIDATOR_REVIEWERS=
# Максимум находок одной роли за запрос, от 1 до 30.
REQVALIDATOR_REVIEWER_MAX_FINDINGS=5
# Проверять явные версии внешних технологий по известным источникам.
REQVALIDATOR_EXTERNAL_DOCS=false
CONTEXT7_API_KEY=
# Опционально для релиза или CI. В Git берётся HEAD, в этом ZIP версия v0.1.0.
REQVALIDATOR_VERSION=
