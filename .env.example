# Профиль для повторения прогона с ключом Google AI Studio.
# https://aistudio.google.com/apikey
REQVALIDATOR_PROVIDER=compatible
REQVALIDATOR_MODEL=gemini-4-hydrogen
REQVALIDATOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
REQVALIDATOR_API_KEY=
REQVALIDATOR_COMPATIBLE_FORMAT=json_schema

# Для OpenAI Responses переключите провайдер на openai, задайте модель OpenAI,
# очистите REQVALIDATOR_BASE_URL и REQVALIDATOR_API_KEY и заполните OPENAI_API_KEY.
# Заполняйте только параметры, поддерживаемые выбранной моделью.
OPENAI_API_KEY=
REQVALIDATOR_REASONING_EFFORT=
REQVALIDATOR_TEMPERATURE=
REQVALIDATOR_SEED=
REQVALIDATOR_MAX_OUTPUT_TOKENS=

REQVALIDATOR_TIMEOUT=120
REQVALIDATOR_VALIDATION_RETRIES=1
REQVALIDATOR_MAX_INPUT_CHARS=100000
REQVALIDATOR_LOCAL_BATCH_SIZE=6
REQVALIDATOR_MIN_REQUEST_INTERVAL=0
# Опционально для релиза или CI. В Git берётся HEAD, в этом ZIP версия v0.1.0.
REQVALIDATOR_VERSION=
